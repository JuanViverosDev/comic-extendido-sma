    text: "Confirmar la elecci\xF3n final del tipo de emprendimiento.\r"
    options:
    - OptionID: Pag5_Dec5_OptA
      optionLabel: "Startup Tecnol\xF3gica"
      contentLabel: "Pros: Potencial de crecimiento exponencial, innovaci\xF3n continua,
